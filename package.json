{
  "name": "papermock",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @papermock/shared build && pnpm --filter @papermock/api build",
    "build:web": "pnpm --filter @papermock/web build",
    "dev": "pnpm --filter @papermock/shared build && pnpm --filter @papermock/api dev",
    "dev:web": "pnpm --filter @papermock/web dev",
    "dev:api": "pnpm --filter @papermock/shared build && pnpm --filter @papermock/api dev",
    "start": "pnpm --filter @papermock/api start",
    "db:push": "pnpm --filter @papermock/api db:push",
    "db:seed": "pnpm --filter @papermock/api db:seed",
    "db:studio": "pnpm --filter @papermock/api db:studio"
  },
  "packageManager": "pnpm@9.15.0"
}
