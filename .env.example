# Copy to .env — never commit .env
# Neon: pooled connection string, sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Local dev (Render injects PORT in production)
PORT=3000

# JWT ký access token (bắt buộc trên production)
# JWT_SECRET=your-long-random-string

# Web app (apps/web) — optional; để trống khi dev + dùng Vite proxy
# VITE_API_ORIGIN=https://your-api.onrender.com
# VITE_DEV_API_PROXY=http://127.0.0.1:3000
