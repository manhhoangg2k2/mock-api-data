# Copy to .env — never commit .env
# Neon: pooled connection string, sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Local dev (Render injects PORT in production)
PORT=3000

# JWT ký access + refresh token (bắt buộc trên production)
# JWT_SECRET=your-long-random-string
# Access ngắn (mặc định 15m); refresh dài (mặc định 30d)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d
# (legacy) JWT_EXPIRES_IN=7d  — vẫn dùng làm fallback cho access nếu chưa set JWT_ACCESS_EXPIRES_IN

# Google Sign-In (GIS): Client ID dạng xxx.apps.googleusercontent.com — trùng với VITE_GOOGLE_CLIENT_ID ở web
# GOOGLE_CLIENT_ID=

# Web app (apps/web) — optional; để trống khi dev + dùng Vite proxy
# VITE_API_ORIGIN=https://your-api.onrender.com
# VITE_DEV_API_PROXY=http://127.0.0.1:3000
