# Vite dùng envDir = thư mục code/mock-api-data/ — có thể đặt mọi VITE_* trong file .env gốc đó (không bắt buộc file riêng dưới apps/web/).
#
# Bỏ trống khi dev: Vite proxy /health và /api → http://127.0.0.1:3000
# Production / gọi API Render từ máy:
# VITE_API_ORIGIN=https://your-service.onrender.com

# Google Identity Services — nút "Tiếp tục với Google" (cùng Client ID với GOOGLE_CLIENT_ID trên API)
VITE_GOOGLE_CLIENT_ID=445934143587-ns1r4a3rd83j9e2r1u1ajkq5s43720b1.apps.googleusercontent.com

# Đổi port API local nếu cần (chỉ dev, file .env ở thư mục code/)
# VITE_DEV_API_PROXY=http://127.0.0.1:3000
